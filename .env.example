# pybaiduphoto 环境配置示例
# 复制此文件为 .env 并填写你的值

# ================================
# Baidu Photo Cookies（百度相册 Cookies）
# ================================
# 从浏览器登录百度相册后获取
# 格式：key1=value1; key2=value2; ...
# 注意：永远不要将实际的 .env 文件提交到版本控制！
PYBAIDUPHOTO_COOKIES="BAIDUID=your_value_here;STOKEN=your_value_here;BDUSS_BFESS=your_value_here"

# ================================
# 日志配置（Logging Configuration）
# ================================

# 日志级别
# 选项：DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG - 最详细的信息，用于调试
# INFO - 一般信息
# WARNING - 警告信息（默认）
# ERROR - 错误信息
# CRITICAL - 严重错误
PYBAIDUPHOTO_LOG_LEVEL=INFO

# 是否输出到文件
# true - 输出到文件
# false - 不输出到文件
PYBAIDUPHOTO_LOG_TO_FILE=true

# 日志文件名
PYBAIDUPHOTO_LOG_FILE=pybaiduphoto.log

# 日志目录
# 日志文件将保存在此目录下
PYBAIDUPHOTO_LOG_DIR=logs

# 是否输出到控制台
# true - 在控制台显示日志
# false - 不在控制台显示日志（生产环境推荐）
PYBAIDUPHOTO_CONSOLE_OUTPUT=true

# 是否使用详细格式
# true - 包含文件名和行号（便于调试）
# false - 基本格式
PYBAIDUPHOTO_DETAILED_FORMAT=false

# 日志轮转模式
# size - 按文件大小轮转（默认，10MB 后创建新文件）
# time - 按时间轮转（每天一个新文件）
PYBAIDUPHOTO_LOG_ROTATION=size

# ================================
# 下载配置（Download Configuration）
# ================================

# 是否在日志中打印 OnlineItem 列表
# 1 - 打印所有获取到的 OnlineItem 对象信息（便于调试）
# 0 - 不打印（默认）
# 注意：如果照片数量很多，设置为 1 会产生大量日志
PYBAIDUPHOTO_LOG_ONLINE_ITEMS=0

# 是否自动解压下载的 ZIP 文件
# 1 - 自动解压到 extracted 子目录（推荐）
# 0 - 不自动解压（默认）
PYBAIDUPHOTO_AUTO_EXTRACT_ZIP=1

# 解压后是否删除 ZIP 文件
# 1 - 解压后删除 ZIP 文件（节省磁盘空间）
# 0 - 保留 ZIP 文件（默认）
# 注意：只有在 PYBAIDUPHOTO_AUTO_EXTRACT_ZIP=1 时才生效
PYBAIDUPHOTO_DELETE_ZIP_AFTER_EXTRACT=0

# ================================
# 代理配置（Proxy Settings）
# ================================
# 如果需要使用代理，取消下面的注释并填写代理地址

# 统一代理（同时用于 HTTP 和 HTTPS）
# PYBAIDUPHOTO_ALL_PROXY=socks5://127.0.0.1:1080

# 分别配置 HTTP 和 HTTPS 代理
# PYBAIDUPHOTO_HTTP_PROXY=http://127.0.0.1:8080
# PYBAIDUPHOTO_HTTPS_PROXY=https://127.0.0.1:8443

# ================================
# 快速配置示例
# ================================

# 开发环境配置（推荐）
# PYBAIDUPHOTO_LOG_LEVEL=DEBUG
# PYBAIDUPHOTO_LOG_TO_FILE=true
# PYBAIDUPHOTO_CONSOLE_OUTPUT=true
# PYBAIDUPHOTO_DETAILED_FORMAT=true

# 生产环境配置（推荐）
# PYBAIDUPHOTO_LOG_LEVEL=WARNING
# PYBAIDUPHOTO_LOG_TO_FILE=true
# PYBAIDUPHOTO_CONSOLE_OUTPUT=false
# PYBAIDUPHOTO_DETAILED_FORMAT=true
# PYBAIDUPHOTO_LOG_ROTATION=time

# 调试配置（快速排查问题）
# PYBAIDUPHOTO_LOG_LEVEL=DEBUG
# PYBAIDUPHOTO_LOG_TO_FILE=true
# PYBAIDUPHOTO_CONSOLE_OUTPUT=true
# PYBAIDUPHOTO_DETAILED_FORMAT=true

# 下载并解压配置（推荐用于大量照片）
# PYBAIDUPHOTO_LOG_ONLINE_ITEMS=0
# PYBAIDUPHOTO_AUTO_EXTRACT_ZIP=1
# PYBAIDUPHOTO_DELETE_ZIP_AFTER_EXTRACT=0

# 下载、解压并删除 ZIP（节省磁盘空间）
# PYBAIDUPHOTO_LOG_ONLINE_ITEMS=0
# PYBAIDUPHOTO_AUTO_EXTRACT_ZIP=1
# PYBAIDUPHOTO_DELETE_ZIP_AFTER_EXTRACT=1